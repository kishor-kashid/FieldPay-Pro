{
  "name": "fieldpay-pro-backend",
  "version": "1.0.0",
  "description": "Clean Scapes P4P System - Backend API",
  "main": "index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "serve": "firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "jest",
    "seed": "node utils/seedData.js",
    "create-firebase-users": "node utils/createFirebaseUsers.js",
    "setup-db": "node scripts/setupDatabase.js"
  },
  "keywords": [
    "payroll",
    "p4p",
    "performance"
  ],
  "author": "Clean Scapes",
  "license": "ISC",
  "dependencies": {
    "@supabase/supabase-js": "^2.38.4",
    "axios": "^1.6.2",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "csv-parser": "^3.0.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "firebase-admin": "^11.11.0",
    "firebase-functions": "^4.5.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "node-cron": "^3.0.2"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^7.1.4"
  },
  "jest": {
    "testEnvironment": "node",
    "coveragePathIgnorePatterns": [
      "/node_modules/"
    ],
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  }
}
